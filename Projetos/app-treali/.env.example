# Generate password hashes with: npm run hash:password -- "a senha"
TREALI_SESSION_SECRET=replace-with-a-long-random-secret
TREALI_ACCOUNTS_JSON=[{"login":"muriae-demo","passwordHash":"replace-with-pbkdf2-hash","distributorId":"muriae","cityId":"muriae-mg","slug":"muriae-mg","label":"Distribuidor Muriaé"},{"login":"barbacena-demo","passwordHash":"replace-with-pbkdf2-hash","distributorId":"barbacena","cityId":"barbacena-mg","slug":"barbacena-mg","label":"Distribuidor Barbacena"}]
# Set this in Vercel after running npm run import:catalogs with approved data.
TREALI_CATALOG_REVISION=replace-with-approved-revision
# Em arquivos .env locais, escape cada $ do passwordHash como \$ para evitar expansão pelo carregador de ambiente.
